{
  "rules": {
    "events": {
      "$code": {
        "owner": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
        },
        "status": {
          ".read": true,
          ".write": "auth != null && root.child('events').child($code).child('owner').val() === auth.uid"
        },
        "teams": {
          ".read": true,
          ".write": "auth != null && root.child('events').child($code).child('owner').val() === auth.uid"
        },
        "pins": {
          ".write": "auth != null && root.child('events').child($code).child('owner').val() === auth.uid"
        },
        "pinCheck": {
          "$team": {
            "$device": {
              ".write": "newData.exists() && root.child('events').child($code).child('pins').child($team).exists() && newData.child('pin').val() === root.child('events').child($code).child('pins').child($team).val()"
            }
          }
        },
        "bids": {
          ".read": "auth != null && root.child('events').child($code).child('owner').val() === auth.uid",
          "$win": {
            "$team": {
              ".write": "!data.exists() && root.child('events').child($code).child('status').child('bidding').child('id').val() === $win && root.child('events').child($code).child('status').child('bidding').child('open').val() === true && (!root.child('events').child($code).child('pins').child($team).exists() || newData.child('pin').val() === root.child('events').child($code).child('pins').child($team).val())",
              ".validate": "newData.hasChildren(['amount', 'at']) && newData.child('amount').isNumber() && newData.child('amount').val() > 0 && newData.child('at').val() === now && root.child('events').child($code).child('teams').child($team).exists()"
            }
          }
        }
      }
    },
    "cc": {
      "$code": {
        ".write": "auth != null && data.child('owner').val() === auth.uid && !newData.exists()",
        "owner": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid || (newData.val() === auth.uid && root.child('cc').child($code).child('handover').exists() && newData.parent().child('handoverTry').child(auth.uid).val() === root.child('cc').child($code).child('handover').val()) || (newData.val() === auth.uid && (auth != null && root.child('cc').child($code).child('cokey').exists() && root.child('cc').child($code).child('cohosts').child(auth.uid).val() === root.child('cc').child($code).child('cokey').val())))"
        },
        "handover": {
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 8)"
        },
        "handoverTry": {
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 20"
          }
        },
        "cokey": {
          ".read": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 8)"
        },
        "cohosts": {
          ".read": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('cc').child($code).child('cokey').val()"
          }
        },
        "prop": {
          ".read": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$uid": {
            "$id": {
              ".write": "auth != null && auth.uid === $uid && (auth != null && root.child('cc').child($code).child('cokey').exists() && root.child('cc').child($code).child('cohosts').child(auth.uid).val() === root.child('cc').child($code).child('cokey').val())",
              ".validate": "newData.hasChildren(['base', 'state']) && newData.child('base').isNumber() && newData.child('state').isString()"
            }
          }
        },
        "propAck": {
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "pub": {
          ".read": true,
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid"
        },
        "allowed": {
          ".read": true,
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid"
        },
        "regcode": {
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid"
        },
        "host": {
          ".read": "(auth != null && root.child('cc').child($code).child('owner').val() === auth.uid) || (auth != null && root.child('cc').child($code).child('cokey').exists() && root.child('cc').child($code).child('cohosts').child(auth.uid).val() === root.child('cc').child($code).child('cokey').val())",
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid"
        },
        "pins": {
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$team": {
            ".write": "!data.exists() && newData.exists() && root.child('cc').child($code).child('pub').child('regOpen').val() === true && root.child('cc').child($code).child('allowed').child($team).val() === true && newData.parent().parent().child('reg').child($team).exists()",
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,6}$/)"
          }
        },
        "reg": {
          ".read": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$team": {
            ".read": "(auth != null && root.child('cc').child($code).child('owner').val() === auth.uid) || (auth != null && root.child('cc').child($code).child('sess').child($team).child('uid').val() === auth.uid)",
            ".write": "!data.exists() && newData.exists() && auth != null && newData.child('uid').val() === auth.uid && root.child('cc').child($code).child('pub').child('regOpen').val() === true && root.child('cc').child($code).child('allowed').child($team).val() === true && newData.parent().parent().child('pins').child($team).exists() && (!root.child('cc').child($code).child('regcode').exists() || newData.child('code').val() === root.child('cc').child($code).child('regcode').val())",
            ".validate": "newData.hasChildren(['m', 'at', 'uid']) && newData.child('at').val() === now && newData.child('m').child('0').isString() && newData.child('m').child('1').isString() && newData.child('m').child('2').isString() && newData.child('m').child('3').isString() && newData.child('m').child('0').val().length > 0 && newData.child('m').child('1').val().length > 0 && newData.child('m').child('2').val().length > 0 && newData.child('m').child('3').val().length > 0 && newData.child('m').child('0').val().length <= 40 && newData.child('m').child('1').val().length <= 40 && newData.child('m').child('2').val().length <= 40 && newData.child('m').child('3').val().length <= 40 && !newData.child('m').child('4').exists()"
          }
        },
        "sess": {
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$team": {
            ".read": "(auth != null && root.child('cc').child($code).child('owner').val() === auth.uid) || (auth != null && data.child('uid').val() === auth.uid)",
            ".write": "newData.exists() && auth != null && newData.child('uid').val() === auth.uid && newData.parent().parent().child('reg').child($team).exists() && newData.child('pin').val() === newData.parent().parent().child('pins').child($team).val()",
            ".validate": "newData.hasChildren(['uid', 'pin', 'at']) && newData.child('at').val() === now"
          }
        },
        "online": {
          ".read": true,
          "$team": {
            ".write": "auth != null && root.child('cc').child($code).child('sess').child($team).child('uid').val() === auth.uid",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        },
        "priv": {
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$team": {
            ".read": "(auth != null && root.child('cc').child($code).child('owner').val() === auth.uid) || (auth != null && root.child('cc').child($code).child('sess').child($team).child('uid').val() === auth.uid)"
          }
        },
        "bids": {
          ".read": "(auth != null && root.child('cc').child($code).child('owner').val() === auth.uid) || (auth != null && root.child('cc').child($code).child('cokey').exists() && root.child('cc').child($code).child('cohosts').child(auth.uid).val() === root.child('cc').child($code).child('cokey').val())",
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$lot": {
            "$team": {
              "$bid": {
                ".write": "!data.exists() && newData.exists() && auth != null && root.child('cc').child($code).child('sess').child($team).child('uid').val() === auth.uid && root.child('cc').child($code).child('pub').child('lot').child('id').val() === $lot && root.child('cc').child($code).child('pub').child('lot').child('status').val() === 'auction' && root.child('cc').child($code).child('pub').child('lot').child('mode').val() === 'mobile' && now <= root.child('cc').child($code).child('pub').child('lot').child('deadline').val()",
                ".validate": "newData.hasChildren(['a', 'at']) && newData.child('at').val() === now && newData.child('a').isNumber() && newData.child('a').val() >= root.child('cc').child($code).child('pub').child('lot').child('minBid').val() && newData.child('a').val() <= root.child('cc').child($code).child('priv').child($team).child('purse').val() && ((newData.child('a').val() < 100 && newData.child('a').val() % root.child('cc').child($code).child('pub').child('cfg').child('inc').val() === 0) || (newData.child('a').val() >= 100 && newData.child('a').val() % root.child('cc').child($code).child('pub').child('cfg').child('incCr').val() === 0) || newData.child('a').val() === root.child('cc').child($code).child('pub').child('lot').child('base').val())"
              }
            }
          }
        },
        "ans": {
          ".read": "(auth != null && root.child('cc').child($code).child('owner').val() === auth.uid) || (auth != null && root.child('cc').child($code).child('cokey').exists() && root.child('cc').child($code).child('cohosts').child(auth.uid).val() === root.child('cc').child($code).child('cokey').val())",
          ".write": "auth != null && root.child('cc').child($code).child('owner').val() === auth.uid",
          "$win": {
            "$team": {
              ".write": "!data.exists() && newData.exists() && auth != null && root.child('cc').child($code).child('sess').child($team).child('uid').val() === auth.uid && root.child('cc').child($code).child('pub').child('q').child('win').val() === $win && now <= root.child('cc').child($code).child('pub').child('q').child('deadline').val() && (root.child('cc').child($code).child('pub').child('q').child('elig').val() === 'all' || (root.child('cc').child($code).child('pub').child('q').child('elig').val() === 'owner' && root.child('cc').child($code).child('pub').child('q').child('owner').val() + '' === $team) || (root.child('cc').child($code).child('pub').child('q').child('elig').val() === 'others' && root.child('cc').child($code).child('pub').child('q').child('owner').val() + '' !== $team))",
              ".validate": "newData.hasChildren(['c', 'at']) && newData.child('at').val() === now && (newData.child('c').isNumber() || (newData.child('c').isString() && newData.child('c').val().length <= 60))"
            }
          }
        }
      }
    }
  }
}
